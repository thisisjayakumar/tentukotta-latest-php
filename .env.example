# Copy this file to .env in the repository root and fill in real values.
# .env is git-ignored and must never be committed.
#
# Real process environment variables override values in .env.

# development | testing | production
CI_ENV=production

# Canonical public URL, with trailing slash. If unset the app guesses from the
# request Host header, which lets an attacker influence absolute links.
BASE_URL=https://example.test/

# Database (MySQLi)
DB_HOSTNAME=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# 32+ hex characters. Generate with:
#   php -r "echo bin2hex(random_bytes(16));"
ENCRYPTION_KEY=

# Session lifetime in seconds (7200 = two hours).
SESSION_EXPIRATION=7200

# The web-based updater can execute arbitrary PHP from an uploaded archive.
# Leave this at 0 unless you are performing a controlled upgrade.
ALLOW_WEB_UPDATER=0
